{
  "name": "@agentshield/browser",
  "version": "0.1.0",
  "description": "Lightweight, privacy-first behavioral telemetry client SDK for AgentShield",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentshield/shared": "workspace:*"
  },
  "keywords": [
    "agentshield",
    "browser",
    "telemetry",
    "security",
    "bot-defense",
    "behavior-analysis"
  ],
  "license": "Apache-2.0"
}
