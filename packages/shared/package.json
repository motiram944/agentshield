{
  "name": "@motiramshinde/agentshield-shared",
  "version": "0.1.0",
  "description": "Shared contracts, types, and core interfaces for AgentShield",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
