{
  "name": "@motiramshinde/agentshield-node",
  "version": "0.1.0",
  "description": "Node.js and Express middleware runtime integration for AgentShield",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/motiram944/agentshield.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/motiram944/agentshield#readme",
  "bugs": "https://github.com/motiram944/agentshield/issues",
  "author": "Motiram Shinde",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@motiramshinde/agentshield-core": "workspace:*",
    "@motiramshinde/agentshield-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "keywords": [
    "agentshield",
    "express",
    "middleware",
    "security",
    "firewall",
    "bot-protection"
  ],
  "license": "Apache-2.0"
}
